# ── Railway · servicio "liquidity-demo" (EJECUCIÓN REAL en Bybit Demo Trading) ──
# Demo Trading = mercado REAL (precios/libro reales) con plata VIRTUAL. A diferencia del paper
# (fills simulados), acá se colocan órdenes reales en el exchange → fills/timing/slippage reales.
#
# Crear servicio en Railway:
#   New Service → Deploy from GitHub repo → (mismo repo que los servicios paper)
#   Usa el railway.toml de la raíz → Dockerfile.liquidity (binario Rust) + región Singapur.
#   Settings → Variables → pegar estas:

SYMBOL=BTCUSDT
TF=15
SYSTEM=flow                # el ejecutor SIEMPRE usa flow (ruteado); esto es para el paper-book interno
HIGH_VOL_ONLY=true         # config validada

# ── Ejecución real DEMO ──
EXEC_MODE=demo             # off (default) | demo | testnet | live
BYBIT_API_KEY=<tu-demo-key>        # creada DENTRO de Demo Trading en bybit.com
BYBIT_API_SECRET=<tu-demo-secret>
EXEC_QTY=0.001             # tamaño base (BTC); ETH 0.01 / SOL 0.1
EXEC_LEVERAGE=1
# EXEC_PX_DEC=1            # opcional: decimales de precio (default por símbolo)

# ── Supabase (correr antes migrations/liquidity_exec_trades.sql) ──
SUPABASE_URL=https://jubpovmsfvaqfnidozfh.supabase.co
SUPABASE_KEY=<your-supabase-service-role-key>
