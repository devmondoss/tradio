# Servicio "liquidations" — colector forward de liquidaciones (independiente del paper).
# Railway: en el servicio nuevo, Settings → Build → Dockerfile Path = Dockerfile.liquidations
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir websockets
COPY archive/live/liquidation_collector.py /app/live/liquidation_collector.py
# -u = logs sin buffer (Railway los muestra al instante)
CMD ["python", "-u", "live/liquidation_collector.py"]
