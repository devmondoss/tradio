# If the Railway service is named monitor-spot-paper, MONITOR_EXCHANGE and
# MONITOR_PROFILE are auto-detected as bybit_spot + mtf_spot_paper.
# Keep these explicit vars if the service name is different.
MONITOR_EXCHANGE=bybit_spot
MONITOR_PROFILE=mtf_spot_paper
MONITOR_STRATEGIES=mtf_spot_shorts,mtf_spot_longs
SYMBOLS=BTCUSDT
TIMEFRAME_MIN=1
SUPABASE_URL=
SUPABASE_KEY=
