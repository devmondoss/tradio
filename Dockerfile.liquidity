# Build del servicio (mismo servicio Railway) → corre la estrategia de LIQUIDEZ en Python.
# Reemplaza al build Rust (Dockerfile) vía railway.toml. El Dockerfile Rust queda intacto en el repo;
# para volver al monitor Rust: en railway.toml, dockerfilePath = "Dockerfile".
FROM python:3.12-slim
WORKDIR /app
COPY live/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY live/levels.py live/paper_liquidity.py ./
# -u = stdout sin buffer (logs en vivo). Railway inyecta $PORT → health server.
CMD ["python", "-u", "paper_liquidity.py"]
