FROM rust:1.95-slim AS builder

ENV RUSTUP_TOOLCHAIN=1.95.0

WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cargo build --release -p liquidity_monitor

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/liquidity_monitor /usr/local/bin/liquidity_monitor

ENV SYMBOL=BTCUSDT
ENV TF=15
ENV SYSTEM=both
ENV HIGH_VOL_ONLY=false

CMD ["sh", "-c", "\
  if [ -z \"$SUPABASE_URL\" ]; then echo '[ERROR] SUPABASE_URL not set'; exit 1; fi; \
  if [ -z \"$SUPABASE_KEY\" ]; then echo '[ERROR] SUPABASE_KEY not set'; exit 1; fi; \
  exec liquidity_monitor"]
