# ── Railway · servicio "liquidity-paper" (mide fill ratio maker de la estrategia de liquidez) ──
# Crear servicio nuevo en Railway:
#   New Service → Deploy from GitHub repo → Settings → Root Directory = "live"
#   (usa live/Dockerfile automáticamente) → pegar estas variables.
# Es DRY-RUN: datos reales públicos de Bybit, órdenes VIRTUALES, SIN claves de trading, SIN riesgo.

SYMBOL=BTCUSDT
TF=15                      # timeframe de decisión (config final = 15)
HIGH_VOL_ONLY=false        # false = observa ambos regímenes (validar fill ratio comparado)
                           # true  = solo alta vol (cómo se desplegaría en real)

# Supabase (persistencia). Correr antes la migración: migrations/liquidity_paper.sql
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_key

# (NO se necesitan claves de Bybit en dry-run. Solo para --live-testnet, que no se usa aquí.)
