# ── Bybit Live Trading — variables requeridas en Railway ─────────────────────
# Copiar al panel Railway → Service → Variables

# Exchange
MONITOR_EXCHANGE=bybit_spot
MONITOR_PROFILE=mtf_spot_live       # activa ejecución real de órdenes
SYMBOLS=BTCUSDT
TIMEFRAME_MIN=1

# Bybit API (generar en bybit.com → Account → API Management)
# Permisos necesarios: Spot Trading (Read + Write)
# IP whitelist: IP de Railway (recomendado)
BYBIT_API_KEY=your_api_key_here
BYBIT_SECRET_KEY=your_secret_key_here
BYBIT_TESTNET=false                 # cambiar a false para live real

# Position sizing
LIVE_INITIAL_CAPITAL=500.0          # capital inicial en USDT
LIVE_RISK_PCT=0.02                  # 2% del capital por trade
LIVE_MAX_DAILY_LOSS_R=3.0           # kill switch: max pérdida diaria en R
LIVE_MAX_DRAWDOWN_PCT=0.15          # kill switch: max drawdown total 15%

# Supabase (ya configurado para paper, no cambiar)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_key

# Alertas Slack (opcional pero recomendado)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Bybit TESTNET — para validar antes de live real ───────────────────────────
# Usar estas vars primero:
#   BYBIT_API_KEY=testnet_key
#   BYBIT_SECRET_KEY=testnet_secret
#   BYBIT_TESTNET=true
# Testnet: https://testnet.bybit.com
