# ── Railway · servicio "liquidity-eth" (paper ETHUSDT) ──
# New Service → Deploy from GitHub repo → mismo repo, mismo railway.toml
# Variables:

SYMBOL=ETHUSDT
TF=15
HIGH_VOL_ONLY=false
SYSTEM=both

# Config per-asset (ETH: fill mas profundo = calidad de setup, OOS +1.757 vs +1.558 baseline)
FILL_MARGIN_BPS=6
TIMEOUT_HOURS=24
DISABLE_H5=false

SUPABASE_URL=https://jubpovmsfvaqfnidozfh.supabase.co
SUPABASE_KEY=<your-supabase-service-role-key>

# Fade-only (v3): ignora el detector de regimen, toda gestion=fade. Default true.
FORCE_FADE=true
